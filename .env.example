# CLIProxyAPI management Center
CLIPROXY_SECRET_KEY=
CLIPROXY_API_BASE_URL=

# Database
DATABASE_URL=

# Security
PASSWORD=
CRON_SECRET=<any-long-secret-string>

# Display timezone for date grouping in charts (IANA timezone name)
# Examples: UTC, Europe/London, America/New_York, Asia/Tokyo
# Defaults to Asia/Shanghai if not set. Set to your local timezone for correct day/hour grouping.
TIMEZONE=

# PostgreSQL web pool; keep small on the dedicated 1 GB database host.
DATABASE_POOL_MAX=3

# Standalone CPA v8 Collector. Disabled by default; use isolated test endpoints first.
COLLECTOR_ENABLED=false
CPA_INSTANCE_ID=
CPA_REDIS_ADDR=
CPA_MANAGEMENT_BASE_URL=
CPA_MANAGEMENT_KEY=
CPA_USAGE_QUEUE=usage
CPA_ALLOW_PRODUCTION_TARGET=false
COLLECTOR_ALLOW_PRODUCTION_DATABASE=false
COLLECTOR_MODE=pull-first
COLLECTOR_POLL_INTERVAL_MS=10000
COLLECTOR_BATCH_SIZE=100
COLLECTOR_WORKER_ID=
COLLECTOR_LEASE_SECONDS=60

# Optional Collector health freshness override; default is max(60s, 3 x poll interval).
COLLECTOR_HEALTH_STALE_AFTER_MS=

# Phase 4 Processor: independent Inbox consumer; disabled by default.
PROCESSOR_ENABLED=false
PROCESSOR_WORKER_ID=processor
PROCESSOR_BATCH_SIZE=25
PROCESSOR_LEASE_SECONDS=120
PROCESSOR_MAX_ATTEMPTS=8
PROCESSOR_POLL_INTERVAL_MS=1000

# Phase 4 Rollup Worker: rebuilds recent hourly/daily windows; disabled by default.
ROLLUP_ENABLED=false
ROLLUP_TIMEZONE=UTC
ROLLUP_HOURLY_LOOKBACK_HOURS=48
ROLLUP_DAILY_LOOKBACK_DAYS=90
ROLLUP_HOURLY_INTERVAL_MS=60000
ROLLUP_DAILY_INTERVAL_MS=3600000

# Phase 5.5 independent errors-only subscriber; never inherits usage enablement.
ERROR_COLLECTOR_ENABLED=false
ERROR_COLLECTOR_ALLOW_PRODUCTION_TARGET=false
ERROR_COLLECTOR_ALLOW_PRODUCTION_DATABASE=false
ERROR_COLLECTOR_LEASE_SECONDS=45
ERROR_COLLECTOR_MAX_PENDING=256
ERROR_COLLECTOR_MAX_PENDING_BYTES=1048576
ERROR_CORRELATION_WINDOW_MS=120000
