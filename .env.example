# CLIProxyAPI management Center
CLIPROXY_SECRET_KEY=
CLIPROXY_API_BASE_URL=

# Database
DATABASE_URL=

# Security
PASSWORD=
CRON_SECRET=<any-long-secret-string>

# Display timezone for date grouping in charts (IANA timezone name)
# Examples: UTC, Europe/London, America/New_York, Asia/Tokyo
# Defaults to Asia/Shanghai if not set. Set to your local timezone for correct day/hour grouping.
TIMEZONE=

# PostgreSQL web pool; keep small on the dedicated 1 GB database host.
DATABASE_POOL_MAX=3

# Standalone CPA v8 Collector. Disabled by default; use isolated test endpoints first.
COLLECTOR_ENABLED=false
CPA_INSTANCE_ID=
CPA_REDIS_ADDR=
CPA_MANAGEMENT_BASE_URL=
CPA_MANAGEMENT_KEY=
CPA_USAGE_QUEUE=usage
CPA_ALLOW_PRODUCTION_TARGET=false
COLLECTOR_ALLOW_PRODUCTION_DATABASE=false
COLLECTOR_MODE=pull-first
COLLECTOR_POLL_INTERVAL_MS=10000
COLLECTOR_BATCH_SIZE=100
COLLECTOR_PROCESSOR_BATCH_SIZE=50
COLLECTOR_WORKER_ID=
COLLECTOR_LEASE_SECONDS=60
