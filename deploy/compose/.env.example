# Pin an immutable image tag emitted by the GitHub Actions container workflow.
MONITOR_IMAGE=ghcr.io/itsgjy/cliproxyapi-monitor:sha-REPLACE_WITH_COMMIT

# Docker-network address for web / Processor / Rollup.
MONITOR_DATABASE_URL=postgresql://cliproxyapi_monitor:REPLACE_WITH_SECRET@postgres:5432/cliproxyapi_monitor
# Host-network address for the opt-in Docker Collector profile. Discover the host bridge IP during deployment.
MONITOR_DATABASE_URL_HOST=postgresql://cliproxyapi_monitor:REPLACE_WITH_SECRET@172.20.0.4:5432/cliproxyapi_monitor

MONITOR_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CLIPROXY_SECRET_KEY=
CLIPROXY_API_BASE_URL=
CPA_INSTANCE_ID=oracle-primary
TIMEZONE=Asia/Shanghai
DATABASE_POOL_MAX=3

PROCESSOR_BATCH_SIZE=25
PROCESSOR_LEASE_SECONDS=120
PROCESSOR_MAX_ATTEMPTS=8
PROCESSOR_POLL_INTERVAL_MS=1000
ROLLUP_HOURLY_LOOKBACK_HOURS=48
ROLLUP_DAILY_LOOKBACK_DAYS=90
ROLLUP_HOURLY_INTERVAL_MS=60000
ROLLUP_DAILY_INTERVAL_MS=3600000

# Collector is excluded from the default Compose profile and enabled only after production DB backup / restore verification.
COLLECTOR_ENABLED=false
CPA_MANAGEMENT_KEY=REPLACE_WITH_CPA_MANAGEMENT_SECRET
CPA_ALLOW_PRODUCTION_TARGET=false
COLLECTOR_ALLOW_PRODUCTION_DATABASE=false
COLLECTOR_ALLOW_PULL_FALLBACK=false
COLLECTOR_POLL_INTERVAL_MS=10000
COLLECTOR_BATCH_SIZE=100
COLLECTOR_LEASE_SECONDS=60
COLLECTOR_WORKER_ID=monitor-collector

# Production uses native RESP Subscription; never fall back to destructive FIFO pull.
COLLECTOR_MODE=subscribe

# Separate opt-in error-collector profile. These switches do not enable usage.
ERROR_COLLECTOR_ENABLED=false
ERROR_COLLECTOR_ALLOW_PRODUCTION_TARGET=false
ERROR_COLLECTOR_ALLOW_PRODUCTION_DATABASE=false
CPA_ERROR_REDIS_ADDR=127.0.0.1:8317
ERROR_COLLECTOR_LEASE_SECONDS=45
ERROR_COLLECTOR_MAX_PENDING=256
ERROR_COLLECTOR_MAX_PENDING_BYTES=1048576
ERROR_CORRELATION_WINDOW_MS=120000
